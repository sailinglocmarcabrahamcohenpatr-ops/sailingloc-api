<!DOCTYPE html>
<html lang="fr" style="color-scheme:light;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Nouvelle réservation - SailingLoc</title>
    <style>
        :root { color-scheme: light; }
        body { background-color: #f0f4f8 !important; color: #111827 !important; }
    </style>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f8 !important;color:#111827;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color-scheme:light;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8;padding:40px 16px;">
  <tr>
    <td align="center">

      <!-- Brand -->
      <p style="margin:0 0 20px;font-size:15px;font-weight:600;color:#0a4d8c;letter-spacing:0.5px;"><svg width="14" height="18" viewBox="0 0 48 60" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle;margin-right:6px;"><path d="M24 57C13 44 6 33 6 21.5 6 11 14.1 3 24 3s18 8 18 18.5C42 33 35 44 24 57Z" fill="none" stroke="#0a4d8c" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"></path><path d="M24 14 34 34H14Z" fill="#0a4d8c"></path><path d="M10 34Q24 30 38 34Q24 42 10 34Z" fill="#0a4d8c"></path><path d="M8 47q8-5 16 0t16 0" fill="none" stroke="#0a4d8c" stroke-width="2.4" stroke-linecap="round"></path></svg>SailingLoc</p>

      <!-- Card -->
      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:20px;box-shadow:0 8px 32px rgba(0,0,0,0.10);overflow:hidden;">

        <!-- Badge + Title -->
        <tr>
          <td align="center" style="padding:48px 40px 32px;">
            <div style="width:80px;height:80px;background:#0a4d8c;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:24px;">
              <svg width="32" height="40" viewBox="0 0 48 60" xmlns="http://www.w3.org/2000/svg"><path d="M24 57C13 44 6 33 6 21.5 6 11 14.1 3 24 3s18 8 18 18.5C42 33 35 44 24 57Z" fill="none" stroke="#ffffff" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"></path><path d="M24 14 34 34H14Z" fill="#ffffff"></path><path d="M10 34Q24 30 38 34Q24 42 10 34Z" fill="#ffffff"></path><path d="M8 47q8-5 16 0t16 0" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"></path></svg>
            </div>
            <h1 style="margin:0 0 8px;font-size:26px;font-weight:800;color:#111827;">Nouvelle réservation</h1>
            <p style="margin:0;font-size:15px;color:#6b7280;line-height:1.5;">Bonjour <strong style="color:#111827;">{{ prenom }}</strong>, {{ clientNom }} a réservé l'un de vos bateaux.</p>
          </td>
        </tr>

        <!-- Info card -->
        <tr>
          <td style="padding:0 40px 32px;">
            <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;">
              <tr>
                <td style="padding:20px 24px;font-size:14px;color:#374151;line-height:1.6;">
                  <span style="color:#9ca3af;font-size:13px;display:block;margin-bottom:2px;">Bateau</span>
                  <strong style="font-size:15px;">{{ nomBateau }}</strong>
                </td>
              </tr>
              <tr>
                <td style="border-top:1px solid #e5e7eb;padding:16px 24px;font-size:14px;color:#374151;">
                  <span style="color:#9ca3af;font-size:13px;display:block;margin-bottom:2px;">Dates</span>
                  Du {{ dateDebut }} au {{ dateFin }}
                </td>
              </tr>
              <tr>
                <td style="border-top:1px solid #e5e7eb;padding:16px 24px;font-size:13px;color:#6b7280;">
                  La réservation est en attente de votre confirmation.
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CTA Button -->
        <tr>
          <td align="center" style="padding:0 40px 48px;">
            <a href="{{ reservationUrl }}" style="display:inline-block;background:#0a4d8c;color:#ffffff;text-decoration:none;padding:14px 44px;border-radius:8px;font-size:16px;font-weight:700;letter-spacing:0.2px;">Voir la réservation</a>
          </td>
        </tr>

      </table>

      <!-- Footer -->
      <p style="margin:24px 0 0;font-size:12px;color:#9ca3af;text-align:center;">
        <span style="display:inline-block;width:8px;height:8px;background:#4ade80;border-radius:50%;vertical-align:middle;margin-right:6px;"></span>
        Email envoyé par SailingLoc &mdash; &copy; {{ "now"|date("Y") }}
      </p>

    </td>
  </tr>
</table>

</body>
</html>
