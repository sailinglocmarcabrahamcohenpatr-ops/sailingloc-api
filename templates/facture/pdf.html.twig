<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture — Réservation #{{ reservation.id }}</title>
    <style>
        @page { margin: 32px 36px; }
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            background-color: #f0f4f8;
            color: #111827;
            font-size: 12px;
            line-height: 1.5;
        }
        .brand {
            font-size: 15px;
            font-weight: bold;
            color: #0a4d8c;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        h1 {
            font-size: 20px;
            color: #111827;
            margin: 0 0 4px;
        }
        .sub {
            color: #6b7280;
            font-size: 11px;
            margin-bottom: 24px;
        }
        .statut {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: bold;
            color: #ffffff;
            background: #0a4d8c;
        }
        table.section {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 18px;
        }
        table.section td {
            vertical-align: top;
            width: 50%;
            padding: 0;
        }
        .box {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 14px 16px;
        }
        .box + .box { margin-left: 12px; }
        .box-title {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #9ca3af;
            margin-bottom: 6px;
        }
        .box p { margin: 0 0 3px; }
        .box strong { color: #111827; }
        table.details {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 18px;
        }
        table.details th, table.details td {
            border: 1px solid #e5e7eb;
            padding: 8px 10px;
            text-align: left;
            font-size: 11px;
        }
        table.details th {
            background: #f8fafc;
            color: #6b7280;
            font-weight: bold;
            width: 45%;
        }
        .montant {
            font-size: 15px;
            font-weight: bold;
            color: #0a4d8c;
        }
        .total-banner {
            background: #0a4d8c;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 18px;
            text-align: right;
        }
        .total-banner .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #c4d2e0;
        }
        .total-banner .amount {
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
        }
        .footer {
            margin-top: 28px;
            padding-top: 12px;
            border-top: 1px solid #e5e7eb;
            font-size: 9px;
            color: #9ca3af;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="brand"><svg width="14" height="18" viewBox="0 0 48 60" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle;margin-right:6px;"><path d="M24 57C13 44 6 33 6 21.5 6 11 14.1 3 24 3s18 8 18 18.5C42 33 35 44 24 57Z" fill="none" stroke="#0a4d8c" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"></path><path d="M24 14 34 34H14Z" fill="#0a4d8c"></path><path d="M10 34Q24 30 38 34Q24 42 10 34Z" fill="#0a4d8c"></path><path d="M8 47q8-5 16 0t16 0" fill="none" stroke="#0a4d8c" stroke-width="2.4" stroke-linecap="round"></path></svg>SailingLoc</div>
    <h1>Facture</h1>
    <div class="sub">
        N° {{ numeroFacture }} — émise le {{ "now"|date("d/m/Y") }}
        &nbsp;·&nbsp;
        <span class="statut">{{ statutPaiementLabel }}</span>
    </div>

    <table class="section">
        <tr>
            <td>
                <div class="box">
                    <div class="box-title">Facturé à</div>
                    <p><strong>{{ locataire.prenom }} {{ locataire.nom }}</strong></p>
                    <p>{{ locataire.email }}</p>
                </div>
            </td>
            <td>
                <div class="box">
                    <div class="box-title">Loué auprès de</div>
                    <p><strong>{{ proprietaire.prenom }} {{ proprietaire.nom }}</strong></p>
                    <p>{{ proprietaire.email }}</p>
                </div>
            </td>
        </tr>
    </table>

    <table class="details">
        <tr>
            <th>Bateau</th>
            <td>{{ bateau.nomBateau }}{{ bateau.port ? ' — ' ~ bateau.port.nom ~ ' (' ~ bateau.port.ville ~ ')' : '' }}</td>
        </tr>
        <tr>
            <th>Période de location</th>
            <td>Du {{ reservation.dateDebut|date("d/m/Y") }} au {{ reservation.dateFin|date("d/m/Y") }} ({{ nombreJours }} jour{{ nombreJours > 1 ? 's' : '' }})</td>
        </tr>
        <tr>
            <th>Date de réservation</th>
            <td>{{ reservation.dateReservation|date("d/m/Y") }}</td>
        </tr>
        <tr>
            <th>Montant total</th>
            <td class="montant">{{ reservation.montantTotal|number_format(2, ',', ' ') }} €</td>
        </tr>
    </table>

    <div class="total-banner">
        <div class="label">Total TTC</div>
        <div class="amount">{{ reservation.montantTotal|number_format(2, ',', ' ') }} €</div>
    </div>

    <div class="footer">
        Document généré automatiquement par la plateforme SailingLoc — facture #{{ numeroFacture }} associée à la réservation #{{ reservation.id }}.<br>
        Ce document tient lieu de facture pour la prestation de location réservée via SailingLoc.
    </div>
</body>
</html>
