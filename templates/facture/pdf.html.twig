<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture — Réservation #{{ reservation.id }}</title>
    <style>
        @page { margin: 0; }
        body {
            margin: 0;
            font-family: DejaVu Sans, Arial, sans-serif;
            color: #282828;
            font-size: 12px;
            line-height: 1.5;
        }
        .content { padding: 0 36px 36px; }

        .band { background: #0b1929; padding: 22px 36px; margin-bottom: 28px; }
        .band table { width: 100%; border-collapse: collapse; }
        .band td { vertical-align: top; }
        .brand-logo { vertical-align: middle; margin-right: 8px; height: 20px; }
        .brand-name { font-size: 20px; font-weight: bold; color: #ffffff; }
        .tagline { font-size: 9px; color: #c4d2e0; margin-top: 6px; }
        .doc-title { font-size: 16px; font-weight: bold; color: #ffffff; text-align: right; }
        .doc-meta { font-size: 9px; color: #c4d2e0; text-align: right; margin-top: 8px; line-height: 1.7; }

        .cards { width: 100%; border-collapse: separate; border-spacing: 16px 0; margin-bottom: 26px; }
        .card { background: #f6f8fa; border: 1px solid #dee3e9; border-radius: 4px; padding: 14px 16px; width: 50%; vertical-align: top; }
        .card-label { font-size: 8px; font-weight: bold; color: #114b6b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
        .card-line { font-size: 10px; color: #282828; margin: 0 0 3px; }
        .card-line.strong { font-weight: bold; }

        .section-title { font-size: 11px; font-weight: bold; color: #0b1929; margin: 0 0 10px; }

        .grid-table { width: 100%; border-collapse: collapse; margin-bottom: 22px; }
        .grid-table th { background: #0b1929; color: #ffffff; font-size: 9px; font-weight: bold; text-align: left; padding: 9px 10px; }
        .grid-table td { border: 0.6px solid #dee3e9; font-size: 9px; color: #282828; padding: 9px 10px; }
        .grid-table th.right, .grid-table td.right { text-align: right; }
        .grid-table td.strong { font-weight: bold; }

        .bottom-row { width: 100%; border-collapse: collapse; }
        .status-cell { vertical-align: top; width: 50%; }
        .muted-label { font-size: 8px; font-weight: bold; color: #6e7672; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
        .badge { display: inline-block; padding: 6px 12px; border-radius: 10px; font-size: 9px; font-weight: bold; }
        .badge-paid { color: #107a57; background: #def5ea; }
        .badge-pending { color: #b46a08; background: #fef3d2; }
        .badge-failed { color: #be2828; background: #fce0e0; }
        .badge-cancelled { color: #6e7672; background: #edefee; }

        .total-cell { vertical-align: top; width: 50%; text-align: right; }
        .total-banner { display: inline-block; background: #0b1929; border-radius: 5px; padding: 10px 18px; text-align: left; }
        .total-label { font-size: 9px; color: #c4d2e0; text-transform: uppercase; letter-spacing: 0.5px; }
        .total-amount { font-size: 17px; font-weight: bold; color: #ffffff; margin-top: 4px; }

        .footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid #dee3e9; font-size: 8px; font-style: italic; color: #6e7672; }
    </style>
</head>
<body>
    <div class="band">
        <table>
            <tr>
                <td style="width: 50%;">
                    <img class="brand-logo" width="16" height="20" src="data:image/svg+xml;base64," /><span class="brand-name">SailingLoc</span>
                    <div class="tagline">Location de bateaux entre particuliers</div>
                </td>
                <td style="width: 50%;">
                    <div class="doc-title">FACTURE</div>
                    <div class="doc-meta">N° {{ numeroFacture }}<br>Émise le {{ "now"|date("d/m/Y") }}</div>
                </td>
            </tr>
        </table>
    </div>

    <div class="content">
        <table class="cards">
            <tr>
                <td class="card">
                    <div class="card-label">Facturé à</div>
                    <div class="card-line strong">{{ locataire.prenom }} {{ locataire.nom }}</div>
                    <div class="card-line">{{ locataire.email }}</div>
                </td>
                <td class="card">
                    <div class="card-label">Loué auprès de</div>
                    <div class="card-line strong">{{ proprietaire.prenom }} {{ proprietaire.nom }}</div>
                    <div class="card-line">{{ proprietaire.email }}</div>
                </td>
            </tr>
        </table>

        <div class="section-title">Détail de la location</div>
        <table class="grid-table">
            <thead>
                <tr>
                    <th>Bateau</th>
                    <th>Port</th>
                    <th>Période</th>
                    <th>Durée</th>
                    <th class="right">Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ bateau.nomBateau }}</td>
                    <td>{{ bateau.port ? bateau.port.ville : '—' }}</td>
                    <td>{{ reservation.dateDebut|date("d/m/Y") }} - {{ reservation.dateFin|date("d/m/Y") }}</td>
                    <td>{{ nombreJours }} nuit{{ nombreJours > 1 ? 's' : '' }}</td>
                    <td class="right strong">{{ reservation.montantTotal|number_format(2, ',', ' ') }} €</td>
                </tr>
            </tbody>
        </table>

        <table class="bottom-row">
            <tr>
                <td class="status-cell">
                    <div class="muted-label">Statut du paiement</div>
                    <span class="badge badge-{{ statutPaiementKey }}">{{ statutPaiementLabel }}</span>
                </td>
                <td class="total-cell">
                    <div class="total-banner">
                        <div class="total-label">Total TTC</div>
                        <div class="total-amount">{{ reservation.montantTotal|number_format(2, ',', ' ') }} €</div>
                    </div>
                </td>
            </tr>
        </table>

        <div class="footer">
            SailingLoc — plateforme de location de bateaux entre particuliers. Ce document tient lieu de facture pour la prestation de location réservée via SailingLoc.
        </div>
    </div>
</body>
</html>
